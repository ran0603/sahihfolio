{
  "name": "@sahihfolio/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, TypeScript types, constants, and utility functions for Sahihfolio",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./screening": "./src/screening.ts",
    "./types": "./src/types/index.ts",
    "./constants": "./src/constants/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./utils": "./src/utils/index.ts",
    "./provider-data": "./src/provider-data.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sahihfolio/config": "workspace:*",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
